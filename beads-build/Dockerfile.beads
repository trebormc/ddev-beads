#ddev-generated
# Beads (bd) task tracker container for DDEV
# Lightweight: Node.js 22 + Beads CLI + sshd

FROM ubuntu:24.04

ARG USERNAME=beads
ARG USER_UID
ARG USER_GID

ENV DEBIAN_FRONTEND=noninteractive
ENV USERNAME=${USERNAME}
ENV USER_HOME=/home/${USERNAME}

# Install only what Beads needs (plus sshd for AI container access)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    gnupg \
    sudo \
    libicu74 \
    openssh-server \
    && mkdir -p /var/run/sshd \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 22 (required for Beads)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Dolt (SQL database with git-like versioning, required by Beads)
RUN curl -L https://github.com/dolthub/dolt/releases/latest/download/install.sh | bash \
    && dolt version

# Install Beads (bd) - Git-backed task tracker.
# The npm package is a thin wrapper: its postinstall downloads the matching
# native binary from GitHub Releases. Upstream has deleted releases before
# (e.g. v1.0.5) while npm's `latest` still pointed to it, which 404s the
# download and breaks the build. So try `latest` first and fall back through
# known-good versions until one installs successfully.
RUN for v in latest 1.1.0 1.0.4; do \
        echo "Installing @beads/bd@$v..."; \
        if npm install -g "@beads/bd@$v"; then \
            echo "Installed @beads/bd@$v"; \
            break; \
        fi; \
        echo "@beads/bd@$v failed, trying next fallback..."; \
    done \
    && bd version

# Create user with matching UID/GID
RUN existing_user=$(getent passwd ${USER_UID} | cut -d: -f1) \
    && existing_group=$(getent group ${USER_GID} | cut -d: -f1) \
    && if [ -n "$existing_user" ] && [ "$existing_user" != "${USERNAME}" ]; then \
         userdel -r $existing_user 2>/dev/null || true; \
       fi \
    && if [ -n "$existing_group" ] && [ "$existing_group" != "${USERNAME}" ]; then \
         groupdel $existing_group 2>/dev/null || true; \
       fi \
    && groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} 2>/dev/null || true \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && passwd -d ${USERNAME}

# Configure sshd for AI container access (hardened)
RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf '#!/bin/bash\n. /etc/ddev-env 2>/dev/null\ncd /var/www/html\nif [ -n "$SSH_ORIGINAL_COMMAND" ]; then\n    eval "$SSH_ORIGINAL_COMMAND"\nelse\n    exec bash -l\nfi\n' \
    > /usr/local/bin/ai-ssh-command.sh && chmod +x /usr/local/bin/ai-ssh-command.sh

RUN printf '%s\n' \
    'PermitRootLogin no' \
    'PasswordAuthentication no' \
    'PubkeyAuthentication yes' \
    'UsePAM no' \
    "AllowUsers ${USERNAME}" \
    'AllowTcpForwarding no' \
    'X11Forwarding no' \
    '' \
    "Match User ${USERNAME}" \
    '    ForceCommand /usr/local/bin/ai-ssh-command.sh' \
    > /etc/ssh/sshd_config.d/ai-agent.conf

RUN mkdir -p /var/www/html \
    && chown -R ${USER_UID}:${USER_GID} ${USER_HOME} \
    && chown -R ${USER_UID}:${USER_GID} /var/www/html

USER ${USERNAME}
WORKDIR ${USER_HOME}

# Preconfigure the beads role in the container user's GLOBAL git config
# (~/.gitconfig inside the container — never touches the project). bd resolves
# beads.role via plain `git config --get`, which also reads the global scope,
# so this works whether or not the project is a git repository: it silences
# the per-command "beads.role not configured" warning and stops bd init's
# safety net from writing beads.role into the project's .git/config.
RUN git config --global beads.role maintainer

RUN echo 'alias ll="ls -la"' >> ~/.bashrc \
    && echo 'alias br="bd ready --json"' >> ~/.bashrc \
    && echo '' >> ~/.bashrc \
    && echo 'echo "Beads container ready (task tracker)"' >> ~/.bashrc \
    && echo 'echo "  Commands: bd ready | bd create | bd close | bd show"' >> ~/.bashrc

COPY beads-build/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sudo chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

WORKDIR /var/www/html
